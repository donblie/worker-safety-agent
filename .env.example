# ============================================================
# 环境变量模板 —— 复制本文件为 .env 并填入真实密钥
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥
# ============================================================

# ── DeepSeek API（文本模型：问答 / 培训 / 应急 / Agent 调度）──
# 获取地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ── Qwen-VL API（视觉模型：工地隐患识别）────────────────────
# 获取地址：https://dashscope.aliyun.com
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-max

# ── 通用配置（可选，以下为默认值）──────────────────────────
API_TIMEOUT=30

# ── 知识库配置（可选，以下为默认值）────────────────────────
REGULATIONS_DIR=./data/regulations
EMERGENCY_DIR=./data/emergency
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3
KB_CACHE_DIR=./data/kb_cache
